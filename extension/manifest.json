{
  "manifest_version": 3,
  "name": "JobCheck 登录态捕获助手",
  "version": "0.6.1",
  "description": "手动快照同步投递记录 + 已连接站点定时刷新 + 登录态绑定/采样。只读，Cookie 永不离开浏览器。",
  "action": {
    "default_title": "JobCheck",
    "default_popup": "popup.html"
  },
  "permissions": ["cookies", "tabs", "storage", "activeTab", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["net-capture.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
