# 复制为 .env 并修改。SECRET_KEY 必须更换（openssl rand -hex 32）
SECRET_KEY=change-me-to-a-random-hex-string
DATABASE_URL=sqlite:///./jobcheck.db

# 首次启动引导：若用户表为空且以下两项已配置，则自动创建管理员账号
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# 开发环境前端源（生产由 Nginx 同源反代，无需 CORS）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── LLM 子系统（M4）──────────────────────────────────────────
# provider 可选：heuristic（默认，离线启发式生成，零成本，本地演示/测试用）
#               openai_compatible（DeepSeek/GLM/Qwen 等 OpenAI 兼容接口）
LLM_RECIPE_PROVIDER=heuristic
# LLM_RECIPE_BASE_URL=https://api.deepseek.com
# LLM_RECIPE_MODEL=deepseek-chat
# LLM_RECIPE_API_KEY=sk-...
LLM_CLASSIFY_PROVIDER=heuristic
# LLM_CLASSIFY_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_CLASSIFY_MODEL=glm-4-flash
# LLM_CLASSIFY_API_KEY=...
# 月预算熔断（CNY）：超限暂停配方生成、状态分类降级为待确认
LLM_MONTHLY_BUDGET_CNY=100

# ── T3 DOM 解析 LLM 层（快照链路，2026-09-03）─────────────────
# 规则 DOM 解析失败或可信度不足时接管非模板版式（步骤条/时间线/图标
# title/英文状态）。不配置 = 层关闭（规则照常，零成本）。
# 验证连通：python scripts/smoke_llm_dom.py（真实调用一次，约几厘钱）
LLM_DOM_PROVIDER=heuristic
# LLM_DOM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_DOM_MODEL=glm-4-flash
# LLM_DOM_API_KEY=...
# LLM_DOM_MAX_CHARS=60000
